# ============================================================
# Traveller-Buyer Marketplace - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# PostgreSQL
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change_me_in_production

# JWT
JWT_SECRET=your-256-bit-secret-key-change-in-production-must-be-at-least-32-chars

# Delivery Code HMAC secret
DELIVERY_CODE_SECRET=change-me-delivery-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spring profile (local | dev | prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
